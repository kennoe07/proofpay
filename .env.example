# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The public address of the site, used in permanent links such as onchain receipts.
NEXT_PUBLIC_SITE_URL=https://proofpay-rho.vercel.app

# Default network: "base-sepolia" (testnet, default) or "base" (mainnet).
NEXT_PUBLIC_CHAIN=base-sepolia

# Supabase: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (starts with sb_secret_). Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Coinbase Developer Platform client API key, used by OnchainKit.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Private key of a dedicated ProofPay wallet that signs EAS receipts. It only needs a little ETH
# for fees on each network. Server only: never prefix with NEXT_PUBLIC_, never reuse a personal wallet.
ATTESTER_PRIVATE_KEY=

# Set to true once the receipt signer has ETH on Base mainnet and the schema is registered there
# (scripts/register-eas-schema.mjs base). Until then, receipts are Test mode only.
NEXT_PUBLIC_LIVE_RECEIPTS=false

# Random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
