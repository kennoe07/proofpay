# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Network: "base-sepolia" (testnet, default) or "base" (mainnet).
NEXT_PUBLIC_CHAIN=base-sepolia

# Supabase: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (starts with sb_secret_). Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Coinbase Developer Platform client API key, used by OnchainKit.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
